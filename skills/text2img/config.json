{
  "need_image": false,
  "allow_image": false,
  "label": "t2i文生图",
  "description": "根据用户输入的文字描述，生成对应的图片。",
  "is_default": false,
  "custom_params": [
    {
      "key": "numimagese",
      "label": "数量",
      "type": "text",
      "default": "1",
      "maxlength": 5,
      "width": 40,
      "title": "每次出图数量"
    },
    {
      "key": "zhongzi",
      "label": "种子",
      "type": "text",
      "default": "",
      "maxlength": 20,
      "width": 80,
      "placeholder": "随机",
      "title": "种子"
    },
    {
      "key": "bili",
      "label": "size",
      "type": "select",
      "default": "3x4",
      "options": [
        { "value": "1x1", "label": "◻ 1:1" },
        { "value": "1x2", "label": "▯ 1:2" },
        { "value": "3x4", "label": "▯ 3:4" },
        { "value": "4x3", "label": "▭ 4:3" },
        { "value": "2x1", "label": "▭ 2:1" }
      ]
    },
    {
      "key": "art_style",
      "label": "Lora",
      "type": "select",
      "default": "none",
      "options": [
        { "value": "none", "label": "无" },
        { "value": "moreDetail", "label": "More-Detail" }
      ]
    }
  ]
}
